# URL del backend NestJS. Si corres "nest start:dev" (puerto 3000 por defecto)
# y luego "npm run dev" en el frontend, Next.js normalmente toma el puerto
# 3001 automáticamente porque el 3000 ya está ocupado — en ese caso este valor
# por defecto (localhost:3000) ya es correcto y no necesitas tocar nada.
NEXT_PUBLIC_API_URL=http://localhost:3000
